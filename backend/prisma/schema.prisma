generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  worker
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("users")
}

model Category {
  id       String    @id @default(uuid())
  name     String    @unique
  products Product[]

  @@map("categories")
}

model Product {
  id              String              @id @default(uuid())
  name            String
  category        Category            @relation(fields: [categoryId], references: [id])
  categoryId      String              @map("category_id")
  brand           String?
  modelNumber     String?             @map("model_number")
  description     String?
  purchaseCost    Decimal             @map("purchase_cost") @db.Decimal(10, 2)
  sellingPrice    Decimal             @map("selling_price") @db.Decimal(10, 2)
  stockQuantity   Int                 @default(0) @map("stock_quantity")
  reorderLevel    Int                 @default(5) @map("reorder_level")
  warrantyMonths  Int?                @map("warranty_months")
  imageUrl        String?             @map("image_url")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")
  movements       InventoryMovement[]
  saleItems SaleItem[]

  @@map("products")
}

enum MovementType {
  received
  sold
  damaged
  adjustment
}

model InventoryMovement {
  id        String       @id @default(uuid())
  product   Product      @relation(fields: [productId], references: [id])
  productId String       @map("product_id")
  type      MovementType
  quantity  Int
  reason    String?
  createdBy String?      @map("created_by")
  createdAt DateTime     @default(now()) @map("created_at")

  @@map("inventory_movements")
}
model Customer {
  id        String   @id @default(uuid())
  name      String
  phone     String?
  email     String?
  address   String?
  createdAt DateTime @default(now()) @map("created_at")
  sales     Sale[]
  installmentPlans InstallmentPlan[]

  @@map("customers")
}

enum PaymentMethod {
  cash
  card
  bank_transfer
  online
}

model Sale {
  id             String        @id @default(uuid())
  customer       Customer      @relation(fields: [customerId], references: [id])
  customerId     String        @map("customer_id")
  employeeId     String        @map("employee_id")
  subtotal       Decimal       @db.Decimal(10, 2)
  discount       Decimal       @default(0) @db.Decimal(10, 2)
  tax            Decimal       @default(0) @db.Decimal(10, 2)
  total          Decimal       @db.Decimal(10, 2)
  paymentMethod  PaymentMethod @map("payment_method")
  saleDate       DateTime      @default(now()) @map("sale_date")
  items          SaleItem[]
  payments       Payment[]
  installmentPlan InstallmentPlan?

  @@map("sales")
}

model SaleItem {
  id        String  @id @default(uuid())
  sale      Sale    @relation(fields: [saleId], references: [id])
  saleId    String  @map("sale_id")
  product   Product @relation(fields: [productId], references: [id])
  productId String  @map("product_id")
  quantity  Int
  unitPrice Decimal @map("unit_price") @db.Decimal(10, 2)

  @@map("sale_items")
}

model Payment {
  id       String        @id @default(uuid())
  sale     Sale          @relation(fields: [saleId], references: [id])
  saleId   String        @map("sale_id")
  amount   Decimal       @db.Decimal(10, 2)
  method   PaymentMethod
  paidAt   DateTime      @default(now()) @map("paid_at")

  @@map("payments")
}
model InterestRate {
  id              String   @id @default(uuid())
  durationMonths  Int      @map("duration_months")
  rate            Decimal  @db.Decimal(5, 2)
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  installmentPlans InstallmentPlan[]

  @@map("interest_rates")
}

enum PlanStatus {
  active
  completed
  overdue
  defaulted
}

model InstallmentPlan {
  id                String       @id @default(uuid())
  sale              Sale         @relation(fields: [saleId], references: [id])
  saleId            String       @unique @map("sale_id")
  customer          Customer     @relation(fields: [customerId], references: [id])
  customerId        String       @map("customer_id")
  interestRateRef   InterestRate @relation(fields: [interestRateId], references: [id])
  interestRateId    String       @map("interest_rate_id")
  principal         Decimal      @db.Decimal(10, 2)
  interestRate      Decimal      @map("interest_rate") @db.Decimal(5, 2)
  durationMonths    Int          @map("duration_months")
  monthlyPayment    Decimal      @map("monthly_payment") @db.Decimal(10, 2)
  remainingBalance  Decimal      @map("remaining_balance") @db.Decimal(10, 2)
  nextDueDate       DateTime     @map("next_due_date")
  status            PlanStatus   @default(active)
  payments          InstallmentPayment[]

  @@map("installment_plans")
}

model InstallmentPayment {
  id      String          @id @default(uuid())
  plan    InstallmentPlan @relation(fields: [planId], references: [id])
  planId  String          @map("plan_id")
  amount  Decimal         @db.Decimal(10, 2)
  paidAt  DateTime        @default(now()) @map("paid_at")

  @@map("installment_payments")
}

model Setting {
  key   String @id
  value String

  @@map("settings")
}