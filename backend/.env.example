# ---- PostgreSQL ----
DATABASE_URL=postgresql://smartretail:smartretail@localhost:5433/smartretail?schema=public

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- Temporal ----
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=smartretail-installments

# ---- FR6: installment reminder workflow ----
# Length of one workflow "day" in ms. Leave at 86400000 in production.
# For testing, 10000 makes a weekly installment remind at ~40s, fall due at
# ~70s and go overdue at ~120s after checkout. Restart the backend after changing it.
WORKFLOW_DAY_DURATION_MS=86400000
# Start any missing workflows when the backend boots (recovers from Temporal downtime).
TEMPORAL_SYNC_ON_STARTUP=true

# ---- FR6: email (temporal worker) — Mailpit in dev, UI at http://localhost:8025 ----
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=SmartRetail <no-reply@smartretail.local>

# ---- Auth (backend) ----
JWT_SECRET=change-me
JWT_EXPIRES_IN=8h
SEED_ADMIN_EMAIL=admin@smartretail.local
SEED_ADMIN_PASSWORD=choose-a-strong-admin-password
SEED_WORKER_EMAIL=worker@smartretail.local
SEED_WORKER_PASSWORD=choose-a-strong-worker-password
SEED_INSTALLMENT_INTEREST_RATE=0.1000

# ---- Object storage (invoices/reports, MinIO in dev) ----
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=smartretail

# ---- FR7: invoices & receipts (printed in the PDF header) ----
STORE_NAME=SmartRetail Electronics
STORE_ADDRESS=No. 1, Main Street, Colombo
STORE_PHONE=011 234 5678
STORE_TIMEZONE=Asia/Colombo

# ---- FR8: reports ----
# Date ranges longer than this many days are generated as a background job.
REPORT_SYNC_MAX_DAYS=31
# Finished report files are kept (and re-downloadable) for this many days.
REPORT_RETENTION_DAYS=30
REPORT_POLL_INTERVAL_MS=5000
REPORT_WORKER_ENABLED=true

# ---- Backend ----
PORT=3000
NODE_ENV=development

# ---- Frontend ----
VITE_API_BASE_URL=http://localhost:3000
