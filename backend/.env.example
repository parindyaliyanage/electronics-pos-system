# ---- PostgreSQL ----
DATABASE_URL=postgresql://smartretail:smartretail@localhost:5433/smartretail?schema=public

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- Temporal ----
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=smartretail-installments

# ---- Auth (backend) ----
JWT_SECRET=change-me
JWT_EXPIRES_IN=8h
SEED_ADMIN_EMAIL=admin@smartretail.local
SEED_ADMIN_PASSWORD=choose-a-strong-admin-password
SEED_WORKER_EMAIL=worker@smartretail.local
SEED_WORKER_PASSWORD=choose-a-strong-worker-password

# ---- Object storage (invoices/reports, MinIO in dev) ----
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=smartretail

# ---- Backend ----
PORT=3000
NODE_ENV=development

# ---- Frontend ----
VITE_API_BASE_URL=http://localhost:3000
