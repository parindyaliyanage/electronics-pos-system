{
  "name": "temporal-worker",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "ts-node-dev --transpile-only src/worker.ts",
    "build": "tsc -b",
    "start": "node dist/worker.js",
    "test": "jest --passWithNoTests"
  },
  "dependencies": {
    "@temporalio/activity": "^1.22.0",
    "@temporalio/client": "^1.22.0",
    "@temporalio/worker": "^1.22.0",
    "@temporalio/workflow": "^1.22.0",
    "nodemailer": "^6",
    "pg": "^8"
  },
  "devDependencies": {
    "@temporalio/testing": "1.22.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.14.0",
    "@types/nodemailer": "^6",
    "@types/pg": "^8.23.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testEnvironment": "node"
  }
}
