# ---- PostgreSQL ----
DATABASE_URL=postgresql://smartretail:smartretail@localhost:5432/smartretail?schema=public

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- Temporal ----
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=smartretail-installments

# ---- Auth (backend) ----
JWT_SECRET=change-me
JWT_EXPIRES_IN=8h

# ---- Object storage (invoices/reports, MinIO in dev) ----
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=smartretail

# ---- Backend ----
PORT=3000
NODE_ENV=development

# ---- Frontend ----
VITE_API_BASE_URL=http://localhost:3000
