    {
      "name": "2. Sales and payments create documents",
      "item": [
        {
          "name": "FULL checkout (2 cables -100 each + phone) creates an invoice",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{idemFull}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/sales/checkout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sales",
                "checkout"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"{{customerId}}\",\n  \"items\": [\n    { \"productId\": \"{{cableId}}\", \"quantity\": 2, \"unitPrice\": 1500, \"discount\": 100 },\n    { \"productId\": \"{{phoneId}}\", \"quantity\": 1, \"unitPrice\": 120000, \"serializedUnitId\": \"{{unit1Id}}\" }\n  ],\n  \"payment\": { \"method\": \"CARD\", \"type\": \"FULL\", \"amount\": 122800 }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{cashierToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test(\"Invoice number assigned\", () => pm.expect(body.invoice.invoiceNumber).to.match(/^INV-\\d{6}$/));",
                  "pm.collectionVariables.set(\"fullSaleId\", body.id);",
                  "pm.collectionVariables.set(\"fullInvoiceId\", body.invoice.id);",
                  "pm.collectionVariables.set(\"fullInvoiceNumber\", body.invoice.invoiceNumber);"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"idemFull\", pm.variables.replaceIn(\"{{$guid}}\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "DEPOSIT checkout (phone, 3 weekly) gets the next invoice number",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{idemDeposit}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/sales/checkout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sales",
                "checkout"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"{{customerId}}\",\n  \"items\": [\n    { \"productId\": \"{{phoneId}}\", \"quantity\": 1, \"unitPrice\": 120000, \"serializedUnitId\": \"{{unit2Id}}\" }\n  ],\n  \"payment\": { \"method\": \"CASH\", \"type\": \"DEPOSIT\", \"amount\": 30000 },\n  \"installment\": { \"termCount\": 3, \"paymentFrequency\": \"WEEKLY\" }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{cashierToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "const prev = Number(pm.collectionVariables.get(\"fullInvoiceNumber\").slice(4));",
                  "pm.test(\"Sequential numbering\", () => pm.expect(Number(body.invoice.invoiceNumber.slice(4))).to.eql(prev + 1));",
                  "pm.collectionVariables.set(\"installmentSaleId\", body.id);",
                  "pm.collectionVariables.set(\"planId\", body.installmentPlan.id);",
                  "pm.collectionVariables.set(\"schedule1Id\", body.installmentPlan.schedules[0].id);",
                  "pm.collectionVariables.set(\"depositPaymentId\", body.payments.find((p) => p.type === \"DEPOSIT\").id);"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"idemDeposit\", pm.variables.replaceIn(\"{{$guid}}\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Installment payment (40,000) creates a receipt",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{idemPay}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/installments/{{planId}}/payments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "installments",
                "{{planId}}",
                "payments"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"scheduleId\": \"{{schedule1Id}}\",\n  \"amount\": 40000,\n  \"method\": \"CASH\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
