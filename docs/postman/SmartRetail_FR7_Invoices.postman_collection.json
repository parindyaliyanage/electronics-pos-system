{
  "info": {
    "name": "SmartRetail API - FR7 Invoices and Receipts",
    "description": "FR7 endpoints. Fill adminPassword in the Variables tab and run the whole collection. It creates its own cashier, products, customer and sales. Open any PDF request and click the Body tab to see the document. See docs/API_Endpoints_FR7.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{adminToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "adminEmail",
      "value": "admin@smartretail.local",
      "type": "string"
    },
    {
      "key": "adminPassword",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "runId",
      "value": "",
      "type": "string"
    },
    {
      "key": "cashierId",
      "value": "",
      "type": "string"
    },
    {
      "key": "otherWorkerId",
      "value": "",
      "type": "string"
    },
    {
      "key": "cashierToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "otherToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "categoryId",
      "value": "",
      "type": "string"
    },
    {
      "key": "phoneId",
      "value": "",
      "type": "string"
    },
    {
      "key": "unit1Id",
      "value": "",
      "type": "string"
    },
    {
      "key": "unit2Id",
      "value": "",
      "type": "string"
    },
    {
      "key": "cableId",
      "value": "",
      "type": "string"
    },
    {
      "key": "customerPhone",
      "value": "",
      "type": "string"
    },
    {
      "key": "customerId",
      "value": "",
      "type": "string"
    },
    {
      "key": "idemFull",
      "value": "",
      "type": "string"
    },
    {
      "key": "idemDeposit",
      "value": "",
      "type": "string"
    },
    {
      "key": "idemPay",
      "value": "",
      "type": "string"
    },
    {
      "key": "fullSaleId",
      "value": "",
