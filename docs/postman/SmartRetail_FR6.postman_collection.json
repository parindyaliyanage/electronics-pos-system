    {
      "name": "3. FR6 - after the timeline has run (~2 min)",
      "description": "Run this folder by hand AFTER the schedule-1 workflow has escalated. With WORKFLOW_DAY_DURATION_MS=10000 that is about 2 minutes after checkout. Check 'Workflow status - schedule 1' first: result should be ESCALATED.",
      "item": [
        {
          "name": "Workflow status - schedule 1 (ESCALATED)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/workflows/installments/{{schedule1Id}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "workflows",
                "installments",
                "{{schedule1Id}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"Workflow COMPLETED\", () => pm.expect(body.workflowStatus).to.eql(\"COMPLETED\"));",
                  "pm.test(\"Result ESCALATED\", () => pm.expect(body.result).to.eql(\"ESCALATED\"));",
                  "pm.test(\"Reminder was SENT\", () => pm.expect(body.state.reminder).to.eql(\"SENT\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Reminder log - schedule 1 SENT exactly once",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/installments/{{planId}}/reminders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "installments",
                "{{planId}}",
                "reminders"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{workerToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const rows = pm.response.json().filter((r) => r.scheduleId === pm.collectionVariables.get(\"schedule1Id\"));",
                  "pm.test(\"One reminder row\", () => pm.expect(rows.length).to.eql(1));",
                  "pm.test(\"Status SENT\", () => pm.expect(rows[0].status).to.eql(\"SENT\"));",
                  "pm.test(\"Sent by EMAIL\", () => pm.expect(rows[0].channel).to.eql(\"EMAIL\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Overdue list contains schedule 1",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/installments/overdue",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "installments",
                "overdue"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const row = pm.response.json().data.find((r) => r.scheduleId === pm.collectionVariables.get(\"schedule1Id\"));",
                  "pm.test(\"Schedule 1 is overdue\", () => pm.expect(row).to.be.an(\"object\"));",
                  "pm.test(\"Has customer + outstanding\", () => pm.expect(row).to.include.keys(\"customer\", \"outstanding\", \"daysOverdue\", \"overdueAt\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Partial payment on overdue schedule stays OVERDUE",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{paymentKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/installments/{{planId}}/payments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "installments",
                "{{planId}}",
                "payments"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"scheduleId\": \"{{schedule1Id}}\",\n  \"amount\": 100.00,\n  \"method\": \"CASH\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{workerToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Still OVERDUE\", () => pm.expect(pm.response.json().plan.schedules[0].status).to.eql(\"OVERDUE\"));"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"paymentKey\", pm.variables.replaceIn(\"{{$guid}}\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Pay the rest of schedule 1",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{paymentKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/installments/{{planId}}/payments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "installments",
                "{{planId}}",
                "payments"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"scheduleId\": \"{{schedule1Id}}\",\n  \"amount\": {{schedule1Remaining}},\n  \"method\": \"CASH\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{workerToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Schedule 1 PAID\", () => pm.expect(pm.response.json().plan.schedules[0].status).to.eql(\"PAID\"));"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const remaining = (Number(pm.collectionVariables.get(\"schedule1Amount\")) - 100).toFixed(2);",
                  "pm.collectionVariables.set(\"schedule1Remaining\", remaining);",
                  "pm.collectionVariables.set(\"paymentKey\", pm.variables.replaceIn(\"{{$guid}}\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Overdue list no longer contains schedule 1",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/installments/overdue",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "installments",
                "overdue"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const row = pm.response.json().data.find((r) => r.scheduleId === pm.collectionVariables.get(\"schedule1Id\"));",
                  "pm.test(\"Schedule 1 gone from overdue list\", () => pm.expect(row).to.eql(undefined));"
                ]
              }
            }
          ]
        }
