{
  "info": {
    "name": "SmartRetail API - FR6 Installment Reminder Workflow",
    "description": "FR6 endpoints. Fill adminPassword/workerPassword in the Variables tab. Start the backend with WORKFLOW_DAY_DURATION_MS=10000 and the temporal worker running. Run folders 1 and 2 with the Collection Runner, wait ~2 minutes, then run folder 3. See docs/API_Endpoints_FR6.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{adminToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "adminEmail",
      "value": "admin@smartretail.local",
      "type": "string"
    },
    {
      "key": "adminPassword",
      "value": "",
      "type": "string"
    },
    {
      "key": "workerEmail",
      "value": "worker@smartretail.local",
      "type": "string"
    },
    {
      "key": "workerPassword",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "workerToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "runId",
      "value": "",
      "type": "string"
    },
    {
      "key": "categoryId",
      "value": "",
      "type": "string"
    },
    {
      "key": "productId",
      "value": "",
      "type": "string"
    },
    {
      "key": "productPrice",
      "value": "",
      "type": "string"
    },
    {
      "key": "customerPhone",
      "value": "",
      "type": "string"
    },
    {
      "key": "customerId",
      "value": "",
      "type": "string"
    },
    {
      "key": "idempotencyKey",
      "value": "",
      "type": "string"
    },
    {
      "key": "planId",
      "value": "",
      "type": "string"
    },
    {
      "key": "schedule1Id",
      "value": "",
      "type": "string"
    },
    {
      "key": "schedule1Amount",
      "value": "",
      "type": "string"
    },
    {
      "key": "schedule1Remaining",
      "value": "",
      "type": "string"
    },
    {
      "key": "schedule2Id",
      "value": "",
      "type": "string"
    },
    {
      "key": "schedule2Amount",
      "value": "",
      "type": "string"
    },
    {
      "key": "schedule3Id",
      "value": "",
      "type": "string"
    },
    {
      "key": "schedule3Amount",
      "value": "",
      "type": "string"
    },
    {
      "key": "paymentKey",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Setup - create an installment sale",
      "item": [
        {
          "name": "Login as Administrator",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"adminToken\", pm.response.json().accessToken);"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"runId\", String(Date.now()));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login as Worker",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{workerEmail}}\",\n  \"password\": \"{{workerPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"workerToken\", pm.response.json().accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create category",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/categories",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "categories"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"FR6 Accessories {{runId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"categoryId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create product",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"categoryId\": \"{{categoryId}}\",\n  \"name\": \"FR6 Power Bank {{runId}}\",\n  \"costPrice\": 800.0,\n  \"sellingPrice\": 1500.0,\n  \"isSerialized\": false,\n  \"lowStockThreshold\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set(\"productId\", body.id);",
                  "pm.collectionVariables.set(\"productPrice\", body.sellingPrice);"
                ]
              }
            }
          ]
        },
        {
          "name": "Stock IN 10 units",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/inventory/movements",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "inventory",
                "movements"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"{{productId}}\",\n  \"type\": \"PURCHASE\",\n  \"quantity\": 10\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create customer WITH email",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/customers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "customers"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Kamala Silva\",\n  \"phone\": \"{{customerPhone}}\",\n  \"email\": \"kamala.{{runId}}@example.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{workerToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"customerId\", pm.response.json().customer.id);"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"customerPhone\", \"+9471\" + String(pm.collectionVariables.get(\"runId\")).slice(-7));"
                ]
              }
            }
          ]
        },
        {
          "name": "Set policy: 10%, remind 3 days before, 5 day grace",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/installments/policy",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "installments",
                "policy"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"interestRate\": 0.1,\n  \"reminderDaysBefore\": 3,\n  \"gracePeriodDays\": 5\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"reminderDaysBefore = 3\", () => pm.expect(body.reminderDaysBefore).to.eql(3));",
                  "pm.test(\"gracePeriodDays = 5\", () => pm.expect(body.gracePeriodDays).to.eql(5));"
                ]
              }
            }
          ]
        },
        {
          "name": "Checkout - DEPOSIT + 3 WEEKLY installments (starts 3 workflows)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/sales/checkout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sales",
                "checkout"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"{{customerId}}\",\n  \"items\": [\n    { \"productId\": \"{{productId}}\", \"quantity\": 2, \"unitPrice\": {{productPrice}}, \"discount\": 0 }\n  ],\n  \"payment\": { \"method\": \"CASH\", \"type\": \"DEPOSIT\", \"amount\": 1000.00 },\n  \"installment\": { \"termCount\": 3, \"paymentFrequency\": \"WEEKLY\" }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{workerToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "const plan = pm.response.json().installmentPlan;",
                  "pm.test(\"3 schedules\", () => pm.expect(plan.schedules.length).to.eql(3));",
                  "pm.collectionVariables.set(\"planId\", plan.id);",
                  "plan.schedules.forEach((s, i) => {",
                  "  pm.collectionVariables.set(`schedule${i + 1}Id`, s.id);",
                  "  pm.collectionVariables.set(`schedule${i + 1}Amount`, s.amount);",
                  "});"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"idempotencyKey\", pm.variables.replaceIn(\"{{$guid}}\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. FR6 - right after checkout",
      "item": [
        {
          "name": "Temporal health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/workflows/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "workflows",
                "health"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Temporal is UP\", () => pm.expect(pm.response.json().temporal).to.eql(\"UP\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Workflow status - schedule 1 (RUNNING)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/workflows/installments/{{schedule1Id}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "workflows",
                "installments",
                "{{schedule1Id}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"Workflow RUNNING\", () => pm.expect(body.workflowStatus).to.eql(\"RUNNING\"));",
                  "pm.test(\"Waiting for reminder\", () => pm.expect(body.state.stage).to.eql(\"WAITING_FOR_REMINDER\"));",
                  "pm.test(\"Has a timeline\", () => pm.expect(body.state).to.include.keys(\"reminderAt\", \"dueAt\", \"overdueAt\"));"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "setTimeout(() => {}, 2000); // give the backend a moment to start/signal workflows in the background"
                ]
              }
            }
          ]
        },
        {
          "name": "Workflow status - worker (403)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/workflows/installments/{{schedule1Id}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "workflows",
                "installments",
                "{{schedule1Id}}"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{workerToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 403\", () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "Workflow status - bad UUID (400)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/workflows/installments/not-a-uuid",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "workflows",
                "installments",
                "not-a-uuid"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 400\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Workflow status - unknown schedule (404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/workflows/installments/00000000-0000-4000-8000-0000000000ff",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "workflows",
                "installments",
                "00000000-0000-4000-8000-0000000000ff"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 404\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        },
        {
          "name": "Pay schedule 2 in full early",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{paymentKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/installments/{{planId}}/payments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "installments",
                "{{planId}}",
                "payments"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"scheduleId\": \"{{schedule2Id}}\",\n  \"amount\": {{schedule2Amount}},\n  \"method\": \"CASH\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{workerToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Schedule 2 PAID\", () => pm.expect(pm.response.json().plan.schedules[1].status).to.eql(\"PAID\"));"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"paymentKey\", pm.variables.replaceIn(\"{{$guid}}\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Workflow status - schedule 2 stopped (SETTLED)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/workflows/installments/{{schedule2Id}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "workflows",
                "installments",
                "{{schedule2Id}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"Workflow COMPLETED\", () => pm.expect(body.workflowStatus).to.eql(\"COMPLETED\"));",
                  "pm.test(\"Result SETTLED\", () => pm.expect(body.result).to.eql(\"SETTLED\"));"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "setTimeout(() => {}, 2000); // give the backend a moment to start/signal workflows in the background"
                ]
              }
            }
          ]
        },
        {
          "name": "Force a payment re-check - schedule 1 (202)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/workflows/installments/{{schedule1Id}}/recheck",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "workflows",
                "installments",
                "{{schedule1Id}}",
                "recheck"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 202\", () => pm.response.to.have.status(202));",
                  "pm.test(\"Signalled\", () => pm.expect(pm.response.json().signalled).to.eql(true));"
                ]
              }
            }
          ]
        },
        {
          "name": "Force a re-check - finished workflow (404)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/workflows/installments/{{schedule2Id}}/recheck",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "workflows",
                "installments",
                "{{schedule2Id}}",
                "recheck"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 404\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        },
        {
          "name": "Sync workflows (no duplicates)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/workflows/installments/sync",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "workflows",
                "installments",
                "sync"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"Nothing failed\", () => pm.expect(body.failed).to.eql(0));",
                  "pm.test(\"Existing ones detected\", () => pm.expect(body.alreadyRunning).to.be.at.least(2));"
                ]
              }
            }
          ]
        },
        {
          "name": "Sync - worker (403)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/workflows/installments/sync",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "workflows",
                "installments",
                "sync"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{workerToken}}",
                  "type": "string"
                }
