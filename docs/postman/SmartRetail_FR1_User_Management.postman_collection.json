            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"cashier.{{runId}}@shop.lk\",\n  \"fullName\": \"Sunil Fernando\",\n  \"role\": \"WORKER\",\n  \"password\": \"Passw0rd1\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set(\"newUserId\", body.id);",
                  "pm.test(\"Active by default\", () => pm.expect(body.active).to.eql(true));",
